<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <h1>Hello</h1>
    <p><%= message  %></p>
    <% products.forEach(item => { %>
        <div class="<%= item.name %>">
            <div class="logo-header">
                <img class="<%= item.image %>" src="/image/logo.png" alt="Header" />
            </div>
        </div>
    <% }) %>
</body>
</html>