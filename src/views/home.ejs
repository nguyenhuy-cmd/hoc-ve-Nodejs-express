<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <link rel="stylesheet" href="/css/home.css">
</head>
<style>
    .title {
        font-size: 25px;
        font-weight: 600px;
        padding-bottom: 10px;
    }
</style>

<body>
    <div class="topnav">
        <a class="active" href="/">Home</a>
        <a href="/create">Create Users</a>
    </div>

    <div class="table-container">
        <div class="title">List User</div>
        <table>
            <tr>
                <th>Id</th>
                <th>Email</th>
                <th>Name</th>
                <th>City</th>
                <th>Actions</th>
            </tr>
            <%for(let i=0; i < listUser.length; i++){ %>
                <tr>
                    <td>
                        <%= listUser[i].id %>
                    </td>
                    <td>
                        <%= listUser[i].email %>
                    </td>
                    <td>
                        <%= listUser[i].name%>
                    </td>
                    <td>
                        <%= listUser[i].city%>
                    </td>

                    <td>
                        <a href="/update/<%= listUser[i].id %>"><button>Edit</button></a>
                        <button>Delete</button>
                    </td>
                </tr>
                <%}%>
        </table>
    </div>

</body>

</html>